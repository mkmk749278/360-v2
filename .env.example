# 360-Crypto-Scalping V2 — Configuration
# Copy this file to .env and fill in your values: cp .env.example .env
# Then deploy: sudo bash deploy_vps.sh

# ═══════════════════════════════════════════════════════════════════════
# REQUIRED — fill these in before deploying
# ═══════════════════════════════════════════════════════════════════════

# Telegram Bot — get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Active Trading channel — the SINGLE channel that receives ALL signals
# To get channel ID: add @RawDataBot to the channel, it will print the chat ID
TELEGRAM_ACTIVE_CHANNEL_ID=ID:-1003711676922

# Admin chat — your personal Telegram chat ID (send /start to @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=710718010

# Free channel (optional) — receives top 1–2 daily signals
TELEGRAM_FREE_CHANNEL_ID=ID:-1003782844881

# ══════════════════════════════════════════════════════════════════════
# AUTH — multi-user phone-OTP + Firebase (Phase 2 + Phase 4)
# ══════════════════════════════════════════════════════════════════════

# Owner phone — bootstrapped as user_id=1, tier=owner on first boot of
# a fresh data/lumin.sqlite.  Idempotent: only inserts on an empty DB.
OWNER_PHONE_E164=

# Static admin token — bypasses Firebase ID-token validation for ops /
# CI / 360 CE Ops.  Keep this secret; it's the only way to mutate
# engine state without a Firebase identity.
API_AUTH_TOKEN=

# Legacy local-JWT signing secret.  Kept during the Phase 4 transition
# window while Lumin app versions < firebase-cutover still authenticate
# via /api/auth/anonymous and /api/auth/phone/*.  Removed once all
# clients are on the post-migration APK.
API_JWT_SECRET=

# Billing webhook HMAC secret (used by @LuminProBot → engine for
# POST /internal/billing/grant).  Shared secret; constant-time compare.
BILLING_WEBHOOK_SECRET=

# ══════════════════════════════════════════════════════════════════════
# GOOGLE PLAY BILLING (B16 — in-app subscription paywall)
# ══════════════════════════════════════════════════════════════════════
# Full activation checklist: docs/PLAY_BILLING_ACTIVATION.md
#
# Master switch — the BOOT DEFAULT for the live ops toggle (360 CE Ops →
# Control → "Play billing").  On by default (owner decision 2026-07-16).
# The live on/off state lives on the kill-switch Firestore doc
# (play_billing_enabled); this env value only applies when that flag is unset
# or the kill switch is unbooted.  Fails closed regardless: with no package /
# service account the verifier reports is_configured()=False and every billing
# endpoint 503s even when this is true.  Set false to boot the paywall OFF.
GOOGLE_PLAY_BILLING_ENABLED=true

# Android application id of the Lumin app.  Must match the package Google
# signs RTDN notifications with and the package purchases are made under.
GOOGLE_PLAY_PACKAGE_NAME=org.luminapp.lumin

# Service-account JSON with Android Publisher access (View financial data /
# Manage orders & subscriptions), linked in Play Console → Users &
# permissions → API access.  Separate trust scope from Firebase — prefer a
# dedicated SA.  Store the JSON OUTSIDE the repo; docker-compose mounts it.
# Empty → falls back to FIREBASE_SERVICE_ACCOUNT_PATH.
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=/data/google-play-service-account.json

# Product IDs → tier map.  Defaults already match the app + Play Console
# products; set only to override.  Comma-separated.
# GOOGLE_PLAY_ASSIST_PRODUCT_IDS=lumin_assist_monthly
# GOOGLE_PLAY_AUTO_PRODUCT_IDS=lumin_auto_monthly

# RTDN (Real-Time Developer Notifications) — Google Pub/Sub push keeps
# entitlement live (renew / cancel / expire / refund).  Configure a push
# subscription with OIDC to the endpoint below.
#   Endpoint:  https://api.luminapp.org/api/billing/play/rtdn/<path-secret>
# Expected OIDC audience on the push (set to the full endpoint URL).  Empty
# skips the OIDC check — only acceptable behind the secret-path URL.
GOOGLE_PLAY_RTDN_AUDIENCE=
# Unguessable path segment appended to the RTDN URL (defence-in-depth in
# addition to OIDC).  Must match the <path-secret> in the endpoint URL.
GOOGLE_PLAY_RTDN_PATH_SECRET=

# Firebase project ID — find in Firebase Console > Project Settings.
# Engine ignores Firebase entirely when this is empty.
FIREBASE_PROJECT_ID=

# Path to the Firebase service account JSON.  Used by firebase-admin
# to verify ID tokens (RS256 via Google JWKS) and mint custom tokens
# for the Telegram-OTP fallback path.  Service account needs the
# "Firebase Authentication Admin" role.  Store the JSON outside the
# repo; the docker-compose mount maps it in.
FIREBASE_SERVICE_ACCOUNT_PATH=/data/firebase-service-account.json

# Feature flag — when true, engine accepts Firebase ID tokens on
# protected endpoints (in addition to the legacy HS256 path during
# the transition window).  Defaults to false so landing this code is
# a no-op on the live auth surface until the flip is intentional.
FIREBASE_AUTH_ENABLED=false

# ═══════════════════════════════════════════════════════════════════
# Server-side execution — connect flow (OWNER_BRIEF B18)
# ═══════════════════════════════════════════════════════════════════
#
# The two config groups below are REQUIRED for POST /api/binance/connect
# to work.  If either is missing the connect endpoint returns HTTP 500
# "Server misconfiguration" and users cannot connect their Binance key.

# The engine's public VPS IP — the address users add to their Binance
# API-key IP whitelist.  Read at request time, so a VPS migration can
# flip it without restarting the API process.
#   * The connect flow 500s ("ENGINE_VPS_PUBLIC_IP unset") without it.
#   * Also served (on its own) by GET /api/binance/connect/info so the
#     app can show the whitelist IP up front, even while KMS/Firestore
#     are down.  Not a secret — it is meant to be whitelisted — but the
#     endpoint stays behind the auth gate.
ENGINE_VPS_PUBLIC_IP=

# Cloud KMS envelope-encryption keys (B18).  ALL FOUR must be set or KMS
# init is skipped at boot and the connect flow 500s with "KMS not
# initialised" (the signing service refuses to start outright).  The KMS
# service-account credentials reuse FIREBASE_SERVICE_ACCOUNT_PATH above.
GCP_KMS_PROJECT_ID=
GCP_KMS_LOCATION=
GCP_KMS_KEYRING=
GCP_KMS_KEY_NAME=

# ═══════════════════════════════════════════════════════════════════════
# ENGINE MODE — Top-50 Futures-Only (recommended, low resource usage)
# ═══════════════════════════════════════════════════════════════════════

TOP50_FUTURES_ONLY=true
TOP50_FUTURES_COUNT=75
TOP50_UPDATE_INTERVAL_SECONDS=3600

# ═══════════════════════════════════════════════════════════════════════
# BINANCE API (public endpoints — no keys needed for market data)
# ═══════════════════════════════════════════════════════════════════════

BINANCE_REST_BASE=https://api.binance.com
BINANCE_WS_BASE=wss://stream.binance.com:9443/ws
BINANCE_FUTURES_REST_BASE=https://fapi.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com/ws

# Binance API keys (optional — only needed for authenticated endpoints)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ═══════════════════════════════════════════════════════════════════════
# AI SENTIMENT APIs (optional — engine works without them at ~85% max)
# ═══════════════════════════════════════════════════════════════════════

# CryptoPanic (News Sentiment) — https://cryptopanic.com/developers/api/
NEWS_API_KEY=
# LunarCrush (Social Sentiment) — https://lunarcrush.com/developers
SOCIAL_SENTIMENT_API_KEY=
# Fear & Greed Index (free, no key needed)
FEAR_GREED_API_URL=https://api.alternative.me/fng/?limit=1

# OpenAI GPT-4 (optional macro evaluator) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# On-Chain Intelligence (optional) — https://glassnode.com/
ONCHAIN_API_KEY=

# ═══════════════════════════════════════════════════════════════════════
# ENGINE SETTINGS
# ═══════════════════════════════════════════════════════════════════════

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON=false
PAIR_FETCH_INTERVAL_HOURS=6
TOP_PAIRS_COUNT=75
SCAN_INTERVAL_SECONDS=1
SCAN_MIN_VOLUME_USD=1000000

# Redis (automatically configured in Docker — change only for bare-metal)
REDIS_URL=redis://localhost:6379/0

# Multi-exchange verification (optional, no key needed)
SECOND_EXCHANGE_URL=https://api.bybit.com/v5/market/tickers?category=linear

# Circuit Breaker — auto-pauses after consecutive losses
CIRCUIT_BREAKER_MAX_CONSECUTIVE_SL=3
CIRCUIT_BREAKER_MAX_HOURLY_SL=5
CIRCUIT_BREAKER_MAX_DAILY_DRAWDOWN_PCT=10.0
CIRCUIT_BREAKER_COOLDOWN_SECONDS=900

# Symbol blacklist — comma-separated symbols permanently excluded from scanning.
# Group 1: gold-pegged tokens + micro-caps. Group 2: tokenized stocks
# (crypto-wrapped equities — US-RTH microstructure, not scalpable).
SCAN_SYMBOL_BLACKLIST=XAUTUSDT,PAXGUSDT,MMTUSDT,KOMAUSDT,STOUSDT,AVGOUSDT,QQQUSDT,SKHYNIXUSDT,DRAMUSDT,CRCLUSDT,MUUSDT,INTCUSDT,CLUSDT,EWYUSDT

# Scan cooldowns (seconds, per channel after a signal fires)
SCALP_SCAN_COOLDOWN=600

# Max concurrent signals
MAX_SCALP_SIGNALS=5
MAX_SCALP_FVG_SIGNALS=3
MAX_SCALP_CVD_SIGNALS=3
MAX_SCALP_VWAP_SIGNALS=3
MAX_SCALP_OBI_SIGNALS=3

# Max signal hold duration (seconds)
MAX_SCALP_HOLD=3600

# Thesis cooldown after SL (seconds)
THESIS_COOLDOWN_SCALP=3600

# Signal invalidation momentum threshold
INVALIDATION_MOMENTUM_THRESHOLD_SCALP=0.10

# Performance tracker persistence
PERFORMANCE_TRACKER_PATH=data/signal_performance.json

# ═══════════════════════════════════════════════════════════════════════
# SIGNAL QUALITY OVERHAUL — all controlled by env vars, zero code deleted
# ═══════════════════════════════════════════════════════════════════════

# Active channels (4 active, 4 soft-disabled — flip to true to re-enable)
CHANNEL_SCALP_ENABLED=true
CHANNEL_SCALP_FVG_ENABLED=true
CHANNEL_SCALP_ORDERBLOCK_ENABLED=true
CHANNEL_SCALP_DIVERGENCE_ENABLED=true
CHANNEL_SCALP_CVD_ENABLED=false
CHANNEL_SCALP_VWAP_ENABLED=false
CHANNEL_SCALP_SUPERTREND_ENABLED=false
CHANNEL_SCALP_ICHIMOKU_ENABLED=false

# Per-channel confidence thresholds
MIN_CONFIDENCE_SCALP=80
MIN_CONFIDENCE_FVG=78
MIN_CONFIDENCE_ORDERBLOCK=78
MIN_CONFIDENCE_DIVERGENCE=76

# ADX minimums
ADX_MIN_SCALP=20
ADX_MIN_FVG=18

# Hard gates
SMC_HARD_GATE_MIN=12.0
TREND_HARD_GATE_MIN=10.0

# Regime-aware volume floors (USD 24h)
VOL_FLOOR_TRENDING=3000000
VOL_FLOOR_VOLATILE=5000000
VOL_FLOOR_RANGING=1500000
VOL_FLOOR_QUIET=1000000
VOL_FLOOR_DEFAULT=2000000

# Global cross-channel symbol cooldown (seconds)
GLOBAL_SYMBOL_COOLDOWN_SECONDS=1800

# Correlated position cap
MAX_CORRELATED_SCALP_SIGNALS=4

# ═══════════════════════════════════════════════════════════════════
# PR2: AI ENGAGEMENT LAYER
# ═══════════════════════════════════════════════════════════════════

# Master switches
CONTENT_ENGINE_ENABLED=true
RADAR_CHANNEL_ENABLED=true
SILENCE_BREAKER_ENABLED=true

# Radar thresholds
RADAR_ALERT_MIN_CONFIDENCE=65
RADAR_ALERT_WATCHING_CLOSELY_CONFIDENCE=70
RADAR_PER_SYMBOL_COOLDOWN_SECONDS=900
RADAR_MAX_PER_HOUR=3

# Silence breaker
SILENCE_BREAKER_HOURS=3

# GPT model (gpt-4o-mini is cost-efficient and fast enough)
CONTENT_GPT_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════════════════
# Server-side execution — blast-radius caps (OWNER_BRIEF B18)
# ═══════════════════════════════════════════════════════════════════

# Engine-wide symbol allowlist for auto-trade orders.
#
# Two modes:
#   * UNSET / empty (recommended) → allowlist auto-tracks the engine's
#     live ``PairManager.futures_symbols`` universe (top-75 USDT-M).
#     New pair promotions / demotions flow through automatically; no
#     env edit required.  Per-user picker (Settings → Symbol
#     preference in the app) further narrows per user.
#   * SET to a comma-separated subset → operator hard-narrow.  Even
#     when PairManager has more symbols, only the env list trades.
#     Use this for doctrine-strict modes (paranoid beta, post-
#     incident ratchet-down, etc.).
#
# Examples:
#   TRIPWIRE_SYMBOL_ALLOWLIST=                              # auto-track
#   TRIPWIRE_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT       # hard-narrow
#
# B18 reminder: this is the rooted-VPS blast-radius floor.  Changes
# require owner sign-off.  The dollar cap (MAX_POSITION_USD ×
# MAX_CONCURRENT × rate_limit) is unaffected by this setting.
TRIPWIRE_SYMBOL_ALLOWLIST=

# ─────────────────────────────────────────────────────────────────────────────
# Web billing (Phase 3 — the PWA's crypto rail, docs/WEB_BILLING_DESIGN.md)
# ─────────────────────────────────────────────────────────────────────────────
# Dark-flag-first: all default OFF. Flip on to activate the crypto paywall.
WEB_BILLING_ENABLED=false
WEB_BILLING_CRYPTO_ENABLED=false
# Sandbox vs live NOWPayments API (selects api-sandbox.* vs api.* base).
WEB_BILLING_TEST_MODE=true
# NOWPayments credentials — INJECTED FROM GITHUB SECRETS by deploy.yml
# (secrets: NOWPAYMENTS_API_KEY, NOWPAYMENTS_IPN_SECRET). Engine-env only,
# never logged, never in the app bundle.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
